{
    "cSpell.words": [
        "autotuning",
        "bitonic",
        "Brabec",
        "Cellato",
        "CUDA",
        "inkscape",
        "Klepl",
        "Kokkos",
        "lualatex",
        "mdspan",
        "MLIR",
        "Noarr",
        "parallelizable",
        "SIMT",
        "SYCL",
        "Traverser",
        "Traversers"
    ],

    "[latex]" : {
        "editor.wordWrap": "on",
        "files.encoding": "utf8",
        "files.trimTrailingWhitespace": true,
        "files.trimFinalNewlines": true,
        "files.insertFinalNewline": true,
    },

    "[bibtex]": {
        "editor.wordWrap": "on",
        "files.encoding": "utf8",
        "files.trimTrailingWhitespace": true,
        "files.trimFinalNewlines": true,
        "files.insertFinalNewline": true,
    },

    "todo-tree.regex.regex": "(//|%|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",
    "makefile.configureOnOpen": false
}
