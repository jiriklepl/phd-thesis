    "[latex]" : {
        "editor.wordWrap": "on",
        "files.encoding": "utf8",
        "files.trimTrailingWhitespace": true,
        "files.trimFinalNewlines": true,
        "files.insertFinalNewline": true,
    },

    "[bibtex]": {
        "editor.wordWrap": "on",
        "files.encoding": "utf8",
        "files.trimTrailingWhitespace": true,
        "files.trimFinalNewlines": true,
        "files.insertFinalNewline": true,
    },

    "todo-tree.regex.regex": "(//|\\(|%|#|<!--|;|\\\\|\\\\begin\\{|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "xxx",
        "[ ]",
        "[x]"
    ],
    "makefile.configureOnOpen": false
}
